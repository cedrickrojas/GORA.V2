{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "mobile": {
      "root": "mobile",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "nestjs",
      "entrypoint": "main.js",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "mobile"
      }
    }
  ]
}
