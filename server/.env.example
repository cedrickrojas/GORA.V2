NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gora_db"
# Random value, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Largest member capacity a club may choose (1-100000). Defaults to 1000.
CLUB_MAX_MEMBERS_LIMIT=1000
# IANA zone that decides "today" for game dates. Defaults to Asia/Manila.
GAME_TIMEZONE=Asia/Manila
# Optional persistent directory for uploaded reel videos (default: uploads/reels).
# REEL_UPLOAD_DIR=C:/gora-data/reels
