# Base URL of the GORA API. Do not include a trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Map for game discovery: google, mapbox, osm, or leave empty for the built-in preview
# (no key, no network). Put the provider's browser key in VITE_MAP_API_KEY in your own
# .env only, never in this file or in source code.
VITE_MAP_PROVIDER=
VITE_MAP_API_KEY=
