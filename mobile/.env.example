# Leave empty for same-origin /api/v1 requests on Vercel and local Vite's proxy.
# For a separately hosted API or a native client, set its public origin only
# (for example, https://api.example.com), without /api/v1 or a trailing slash.
# This is a browser build setting, not a Vercel service binding.
VITE_API_BASE_URL=

# Map for game discovery: google, mapbox, osm, or leave empty for the built-in preview
# (no key, no network). Put the provider's browser key in VITE_MAP_API_KEY in your own
# .env only, never in this file or in source code.
VITE_MAP_PROVIDER=
VITE_MAP_API_KEY=

# Location picker street tiles (OpenStreetMap by default; no API key needed).
# Optional compatible OSM tile server. Keep visible OpenStreetMap attribution.
# VITE_LOCATION_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
