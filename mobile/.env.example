# Leave empty for same-origin /api/v1 requests on Vercel and local Vite's proxy.
# For a separately hosted API or a native client, set its public origin only
# (for example, https://api.example.com), without /api/v1 or a trailing slash.
# This is a browser build setting, not a Vercel service binding.
VITE_API_BASE_URL=

# OpenStreetMap is the default and does not need an API key. Google Maps is optional.
VITE_MAP_PROVIDER=osm
VITE_MAP_API_KEY=
VITE_GOOGLE_MAP_ID=

# Optional compatible OSM tile server for the discovery map and location picker.
# Keep visible OpenStreetMap attribution and follow the tile provider's usage policy.
# VITE_LOCATION_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
